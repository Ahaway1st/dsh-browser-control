{
  "manifest_version": 3,
  "name": "DSH Browser Control",
  "version": "1.8.0",
  "description": "DeepSeek Harness 浏览器控制桥：让 DSH Agent 操作你的浏览器（类似 OpenClaw 扩展）。协议契约见 docs/protocol.md v1.0。",
  "permissions": ["tabs", "activeTab", "storage", "notifications", "scripting", "alarms", "debugger"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "DSH Browser Control",
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
